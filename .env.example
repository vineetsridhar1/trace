# Server
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracev2?schema=public"
REDIS_URL="redis://localhost:6379"

# Enables Redis-backed runtime discovery and cross-replica WebSocket routing.
# Leave disabled for a single replica; enable before scaling the server above one.
TRACE_REALTIME_BACKPLANE_ENABLED=0
# TRACE_REPLICA_ID is optional; the server derives a unique process ID by default.
# TRACE_REPLICA_ID=server-1
# TRACE_RUNTIME_COMMAND_TIMEOUT_MS=3000
# TRACE_SHUTDOWN_TIMEOUT_MS=30000

# Ambient agent worker is disabled by default. Set to 1 to run the worker.
TRACE_AGENT_WORKER_ENABLED=0

# Ambient agent worker status heartbeat is disabled by default.
# Set to 1 to publish worker status/aggregation windows to Redis for the debug console.
TRACE_AGENT_STATUS_HEARTBEAT_ENABLED=0
# TRACE_AGENT_STATUS_HEARTBEAT_INTERVAL_MS=15000

# Cloud session groups with no activity for one hour are deprovisioned by default.
# Set either value to 0 to disable the background cleanup job.
# TRACE_CLOUD_SESSION_GROUP_IDLE_CLEANUP_AFTER_MS=3600000
# TRACE_CLOUD_SESSION_GROUP_ACTIVE_IDLE_CLEANUP_AFTER_MS=43200000
# TRACE_CLOUD_SESSION_GROUP_IDLE_CLEANUP_INTERVAL_MS=60000
# Renewable cloud-runtime control lease. A runtime exits if it cannot renew this
# lease through an authenticated bridge connection.
# TRACE_PROVISIONED_RUNTIME_LEASE_DURATION_MS=300000
# Non-renewable fail-safe lifetime. Runtimes and launchers must enforce it even
# if application cleanup and database reconciliation fail.
# TRACE_PROVISIONED_RUNTIME_MAX_LIFETIME_MS=86400000
# Production-mode local QA only: permit provisioned launcher URLs using HTTP on
# exact localhost, 127.0.0.1, or ::1 hosts. Never enable this on hosted Trace.
# TRACE_ALLOW_INSECURE_LOOPBACK_PROVISIONER=0

# Storage — "local" writes to tmp/uploads/ (good for local dev),
# "s3" uses AWS S3 (production default — server defaults to "s3" if unset).
STORAGE_MODE=local
# STORAGE_PUBLIC_URL=http://localhost:4000   # only needed if overriding the default
# LOCAL_STORAGE_DIR=./tmp/uploads            # only needed if overriding the default
# S3_BUCKET=                                 # required when STORAGE_MODE=s3
# AWS_REGION=                                # required when STORAGE_MODE=s3
# TRACE_APP_DEPLOYMENT_ROLE_ARN=             # required to publish generated apps
# TRACE_APP_BUILD_SOURCE_BUCKET=             # private CodeBuild source bundle bucket
# TRACE_APP_DEPLOYMENT_QUEUE_URL=             # encrypted generated-app deployment queue
# TRACE_PUBLISHED_APP_BASE_HOST=              # wildcard host suffix, e.g. apps.trace.example.com
# TRACE_PUBLISHED_APP_BUCKET=                 # private static release bucket
# TRACE_APP_SERVICE_DISCOVERY_NAMESPACE=      # private Cloud Map namespace for service releases

# Desktop
TRACE_WEB_URL="http://localhost:3000"
TRACE_SERVER_PUBLIC_URL="http://localhost:4000"
TRACE_AUTH_COOKIE_SAME_SITE="lax"
# Private cloud previews proxy through the local API server. Keep this port in
# sync with PORT when starting the apps manually; pnpm dev:local sets it for you.
TRACE_ENDPOINT_PREVIEW_BASE_HOST="preview.localhost:4000"
TRACE_ENDPOINT_PREVIEW_PUBLIC_SCHEME="http"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Desktop release build (required by apps/desktop/scripts/forge-release.mjs).
# Baked into the packaged app — set in your shell before running pnpm publish:mac.
TRACE_PRODUCTION_URL="https://app.gettrace.org"
TRACE_DESKTOP_UPDATE_REPO="vineetsridhar1/trace"

# Slack integration (optional). Leave unset to keep Slack fully disabled.
# For local testing, expose the web app (localhost:3000) through a stable HTTPS tunnel
# and use that same origin for TRACE_WEB_URL and SLACK_REDIRECT_URI.
# The Slack app bot scopes must include files:read for image attachments.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
# e.g. https://example.ngrok-free.app/slack/oauth/callback
SLACK_REDIRECT_URI=""
# Local-dev only. Production should omit this so Slack sessions use cloud hosting.
# SLACK_SESSION_HOSTING=local

# Nango application data connections (optional).
# Configure http://localhost:4000/webhooks/nango as the Nango auth webhook URL.
NANGO_SECRET_KEY=""
NANGO_WEBHOOK_SIGNING_KEY=""
# Optional overrides for the server-owned integration catalog.
# NANGO_GITHUB_INTEGRATION_KEY="github-getting-started"
# NANGO_SNOWFLAKE_INTEGRATION_KEY="snowflake"
# NANGO_BASE_URL="https://api.nango.dev"
# NANGO_REQUEST_TIMEOUT_MS=30000
# NANGO_MAX_RESPONSE_BYTES=10485760

# Web build
# Optional for local development. Production builds that use AG Grid Enterprise
# should provide this through CI secrets, never in committed files.
VITE_AG_GRID_LICENSE_KEY=""
