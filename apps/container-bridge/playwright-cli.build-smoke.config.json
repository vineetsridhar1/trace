{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "executablePath": "/usr/bin/chromium",
      "args": ["--disable-dev-shm-usage", "--no-sandbox"]
    },
    "contextOptions": {
      "viewport": {
        "width": 1440,
        "height": 900
      }
    }
  },
  "outputDir": "/tmp/trace-playwright-build-smoke",
  "outputMode": "stdout",
  "allowUnrestrictedFileAccess": false,
  "codegen": "none"
}
