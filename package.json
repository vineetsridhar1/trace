{
  "name": "tracev2",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @trace/web dev",
    "dev:server": "pnpm --filter @trace/server dev",
    "dev:desktop": "pnpm --filter @trace/desktop dev",
    "dev:local": "node ./scripts/dev-local.mjs",
    "dev:local:cloud": "node ./scripts/dev-local.mjs --cloud",
    "dev:web:prod": "VITE_API_URL=https://trace.infra.opendoor.com pnpm --filter @trace/web dev",
    "dev:desktop:prod": "TRACE_SERVER_URL=https://trace.infra.opendoor.com TRACE_WEB_URL=http://localhost:3000 pnpm --filter @trace/desktop dev",
    "dev:desktop:prod-web": "TRACE_SERVER_URL=https://trace.infra.opendoor.com TRACE_WEB_URL=https://trace.infra.opendoor.com pnpm --filter @trace/desktop dev",
    "build": "pnpm --filter @trace/cli... build && pnpm -r build",
    "runtime:check": "node packages/shared/scripts/generate-trace-runtime.mjs --check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:unit:coverage",
    "test:server": "pnpm --filter @trace/server test:unit",
    "test:server:coverage": "pnpm --filter @trace/server test:unit:coverage",
    "smoke:cloud-app-session": "node ./scripts/smoke-cloud-app-session.mjs",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:shared": "pnpm --filter @trace/shared build",
    "gql:codegen": "pnpm --filter @trace/gql codegen",
    "db:migrate": "pnpm --filter @trace/server exec prisma migrate dev",
    "db:generate": "pnpm --filter @trace/server exec prisma generate",
    "codegen": "pnpm db:generate && node packages/gql/scripts/codegen.cjs && pnpm --filter @trace/gql build",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper node_modules/node-pty/prebuilds/linux-*/spawn-helper 2>/dev/null || true"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.0"
  }
}
