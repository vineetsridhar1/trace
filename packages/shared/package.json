{
  "name": "@trace/shared",
  "version": "0.0.2",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "react-native": "src/react-native.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/react-native.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./animal-names": {
      "types": "./dist/animal-names.d.ts",
      "import": "./dist/animal-names.js",
      "require": "./dist/cjs/animal-names.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "require": "./dist/cjs/adapters.js"
    },
    "./trace-runtime": {
      "types": "./dist/trace-runtime.d.ts",
      "import": "./dist/trace-runtime.js",
      "require": "./dist/cjs/trace-runtime.js"
    },
    "./trace-invocation-env": {
      "types": "./dist/trace-invocation-env.d.ts",
      "import": "./dist/trace-invocation-env.js",
      "require": "./dist/cjs/trace-invocation-env.js"
    },
    "./general-workspace": {
      "types": "./dist/general-workspace.d.ts",
      "import": "./dist/general-workspace.js",
      "require": "./dist/cjs/general-workspace.js"
    }
  },
  "typesVersions": {
    "*": {
      "animal-names": [
        "dist/animal-names.d.ts"
      ],
      "adapters": [
        "dist/adapters.d.ts"
      ],
      "trace-runtime": [
        "dist/trace-runtime.d.ts"
      ],
      "trace-invocation-env": [
        "dist/trace-invocation-env.d.ts"
      ],
      "general-workspace": [
        "dist/general-workspace.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/generate-trace-runtime.mjs && tsc -b && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "dev": "pnpm build && (tsc -b --watch & tsc -p tsconfig.cjs.json --watch & wait)",
    "lint": "tsc -b",
    "test": "vitest run"
  },
  "peerDependencies": {
    "node-pty": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "node-pty": "^1.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
