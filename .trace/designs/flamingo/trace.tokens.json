{
  "direction": {
    "name": "Quietly premium workspace",
    "rationale": "Derived from the supplied dark desktop workspace: near-black layered surfaces, fine borders, compact type, and one cool-blue cue make generated artifacts distinct without competing with the conversation."
  },
  "color": {
    "background": "#0d0f12",
    "surface": "#171a1f",
    "foreground": "#f1f3f5",
    "muted": "#9ba1aa",
    "border": "#2d3138",
    "primary": "#5b92ff",
    "primaryForeground": "#071225",
    "secondary": "#69717d",
    "success": "#22c55e",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "dangerForeground": "#ffffff"
  },
  "typography": {
    "display": "Inter, ui-sans-serif, system-ui, sans-serif",
    "body": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, monospace",
    "scale": "1.25"
  },
  "spacing": {
    "base": 4,
    "density": "compact"
  },
  "radius": {
    "control": 9,
    "surface": 14
  },
  "elevation": {
    "surface": "0 18px 48px rgb(0 0 0 / 0.28)"
  },
  "motion": {
    "duration": 180,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
