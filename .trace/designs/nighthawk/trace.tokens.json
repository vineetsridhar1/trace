{
  "direction": {
    "name": "Console calm",
    "rationale": "Match the Trace product's dark zinc console atmosphere: quiet surfaces, high-contrast type, white primary actions, emerald reserved for healthy status."
  },
  "color": {
    "background": "#0a0a0c",
    "surface": "#161619",
    "foreground": "#fafafa",
    "muted": "#9d9da8",
    "border": "#27272d",
    "primary": "#fafafa",
    "primaryForeground": "#0a0a0c",
    "secondary": "#9292a0",
    "success": "#34d399",
    "warning": "#fbbf24",
    "danger": "#ef4444",
    "dangerForeground": "#ffffff"
  },
  "typography": {
    "display": "Inter, ui-sans-serif, system-ui, sans-serif",
    "body": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "scale": "1.2"
  },
  "spacing": {
    "base": 4,
    "density": "balanced"
  },
  "radius": {
    "control": 8,
    "surface": 12
  },
  "elevation": {
    "surface": "0 12px 32px rgb(0 0 0 / 0.32)"
  },
  "motion": {
    "duration": 160,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
